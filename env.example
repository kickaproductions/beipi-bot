# Add real values in Vercel Project Settings > Environment Variables.
# Never commit your real Twitch Client Secret or AUTH_SECRET.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=https://beipi-dashboard.vercel.app/api/auth/twitch/callback
AUTH_SECRET=generate_a_long_random_secret
NEXT_PUBLIC_APP_URL=https://beipi-dashboard.vercel.app

# Public Discord Application ID (not the bot token or client secret)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://beipi-dashboard.vercel.app/api/auth/discord/callback

# Google login and read-only YouTube channel connection
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://beipi-dashboard.vercel.app/api/auth/google/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=https://beipi-dashboard.vercel.app/api/auth/kick/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
